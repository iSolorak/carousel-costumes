DATABASE_URL="file:./dev.db"

# Single-admin auth (see lib/auth.ts). Generate these values from the app
# itself at /admin/setup (no terminal command needed), then paste the output
# here and restart the server.
ADMIN_USERNAME="admin"
# Dev-only default password: "changeme123" — change this before deploying.
ADMIN_PASSWORD_HASH="\$2b\$10\$5u8qKuEq80QuDUdIldfKluLYnYl5RgRu4XWH7gXUJ9bO3Rdc/g2Ym"

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="d3ca9d95234175eaa82360d3241c048c8a810c479c9190ab303b0dfe76f3df64"

# Absolute path on disk (outside the Next.js build output) where uploaded
# costume images are stored. Defaults to ./uploads for local dev.
UPLOADS_DIR="./uploads"
