# Copy to /etc/nginx/sites-available/sakis, symlink into sites-enabled,
# then `nginx -t && systemctl reload nginx`. Run certbot afterwards to
# add HTTPS (it will rewrite this file to add the 443 server block).

server {
    listen 80;
    server_name your-domain.example;

    # Static Next.js assets — long cache, immutable, fingerprinted by Next.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 15M; # allow costume image uploads through the admin
}
